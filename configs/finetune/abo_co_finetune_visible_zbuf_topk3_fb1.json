{
    "models": {
        "encoder": {
            "name": "ElasticSLatEncoder",
            "args": {
                "resolution": 64,
                "in_channels": 1024,
                "model_channels": 768,
                "latent_channels": 8,
                "num_blocks": 12,
                "num_heads": 12,
                "mlp_ratio": 4,
                "attn_mode": "swin",
                "window_size": 8,
                "use_fp16": true
            }
        },
        "decoder": {
            "name": "ElasticSLatGaussianDecoder",
            "args": {
                "resolution": 64,
                "model_channels": 768,
                "latent_channels": 8,
                "num_blocks": 12,
                "num_heads": 12,
                "mlp_ratio": 4,
                "attn_mode": "swin",
                "window_size": 8,
                "use_fp16": true,
                "representation_config": {
                    "lr": {
                        "_xyz": 1.0,
                        "_features_dc": 1.0,
                        "_opacity": 1.0,
                        "_scaling": 1.0,
                        "_rotation": 0.1
                    },
                    "perturb_offset": true,
                    "voxel_size": 1.5,
                    "num_gaussians": 32,
                    "2d_filter_kernel_size": 0.1,
                    "3d_filter_kernel_size": 0.0009,
                    "scaling_bias": 0.004,
                    "opacity_bias": 0.1,
                    "scaling_activation": "softplus"
                }
            }
        }
    },
    "dataset": {
        "name": "SparseFeat2Render",
        "args": {
            "image_size": 512,
            "model": "dinov2_vitl14_reg_visible_zbuf_topk3_fb1",
            "resolution": 64,
            "min_aesthetic_score": 0.0,
            "max_num_voxels": 32768
        }
    },
    "trainer": {
        "name": "SLatVaeGaussianTrainer",
        "args": {
            "max_steps": 120000,
            "batch_size_per_gpu": 1,
            "batch_split": 1,
            "num_workers": 4,
            "optimizer": {
                "name": "AdamW",
                "args": {
                    "lr": 5e-05,
                    "weight_decay": 0.0
                }
            },
            "ema_rate": [
                0.9999
            ],
            "fp16_mode": "inflat_all",
            "fp16_scale_growth": 0.001,
            "elastic": {
                "name": "LinearMemoryController",
                "args": {
                    "target_ratio": 0.75,
                    "max_mem_ratio_start": 0.5
                }
            },
            "grad_clip": {
                "name": "AdaptiveGradClipper",
                "args": {
                    "max_norm": 1.0,
                    "clip_percentile": 95
                }
            },
            "i_log": 200,
            "i_sample": 5000,
            "i_save": 5000,
            "loss_type": "l1",
            "lambda_ssim": 0.2,
            "lambda_lpips": 0.2,
            "lambda_kl": 1e-06,
            "regularizations": {
                "lambda_vol": 10000.0,
                "lambda_opacity": 0.001
            },
            "finetune_ckpt": {
                "encoder": "/speed-scratch/an_zhan/project/TRELLIS-experiments/pretrained_ckpts/slat_enc_swin8_B_64l8_fp16.pt",
                "decoder": "/speed-scratch/an_zhan/project/TRELLIS-experiments/pretrained_ckpts/slat_dec_gs_swin8_B_64l8gs32_fp16.pt"
            }
        }
    }
}
